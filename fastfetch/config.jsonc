{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
	"logo": {
		"type": "small",             // the small Arch logo, not the big one
		"padding": { "right": 2 }
	},
	"display": {
		"separator": "  ",
		"color": { "keys": "yellow", "title": "yellow" }  // st's yellow, i.e. Gruvbox
	},
	"modules": [
		"title",
		"separator",
		"os",
		"kernel",
		"packages",
		"wm",
		"shell",
		"terminal",
		"cpu",
		"memory",
		"disk",
		"battery",
		"break",
		"colors"
	]
}
